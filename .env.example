# ============================================================
# Copy this file to `.env` and fill in. NEVER commit `.env`.
# The app runs fully on mocks with NO keys — see VITE_USE_MOCKS.
# ============================================================

# --- Mock mode (P1/P2/P3 keep this true until P4 says otherwise) ---
# true  = no Firebase, no AI calls. Fake data. Everything works offline.
# false = real Firebase + real tutor endpoint.
VITE_USE_MOCKS=true

# --- Tutor endpoint (owned by P2, deployed by P4) ---
VITE_TUTOR_ENDPOINT=http://127.0.0.1:5001/tinker/us-central1/tutor

# --- Firebase web config (owned by P4; safe to expose, but keep out of git) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ============================================================
# SERVER-SIDE ONLY — these live in functions/.env, never in the
# browser bundle. Anything prefixed VITE_ is PUBLIC.
# ============================================================
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
# GOOGLE_TRANSLATE_API_KEY=xxxxxxxxxxxxxxxx
