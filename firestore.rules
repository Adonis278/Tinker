rules_version = '2';

// Tinker — default deny, then open only what the app actually needs.
//
// The Firebase web apiKey is public by design; THIS FILE is the real security
// boundary. A learner may only ever touch their own document tree.
service cloud.firestore {
  match /databases/{database}/documents {

    // A learner owns their profile and their progress. Anonymous auth still
    // produces a stable uid, so this works without anyone creating an account.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /progress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Curriculum and regional data are read-only to the app and are seeded
    // from the console or a script. Nobody can write them from the client.
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if false;
    }

    match /regions/{regionId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
