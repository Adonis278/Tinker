# ============================================================
# SERVER-SIDE SECRETS
#
# Copy this to `functions/.secret.local` — NOT to `.env`.
#
# Why .secret.local: the Firebase CLI auto-loads functions/.env at DEPLOY time
# as plain environment variables. Because these same names are declared via
# defineSecret() in index.js, having them in .env makes the deploy fail with
#   "Secret environment variable overlaps non secret environment variable".
# `.secret.local` is the supported way to give the local emulator secret
# values, and it is never uploaded.
#
# For DEPLOYED functions the values come from Secret Manager:
#   firebase functions:secrets:set NVIDIA_API_KEY
#   firebase functions:secrets:set GOOGLE_TRANSLATE_API_KEY
# ============================================================

# From https://build.nvidia.com — free tier. Starts with "nvapi-".
NVIDIA_API_KEY=

# Google Cloud Translate. Only needed for the Yoruba/Shona pivot path.
# Leave as "unset" (or empty) and the tutor simply returns untranslated English.
GOOGLE_TRANSLATE_API_KEY=unset
