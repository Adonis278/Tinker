# ============================================================
# Copy this file to `.env` and fill in. NEVER commit `.env`.
# A fresh clone with NO .env at all runs fully mocked — that is intentional.
# ============================================================

# --- Mock switches ---------------------------------------------------------
# Master default. Leave true and the whole app runs with no keys, no network.
VITE_USE_MOCKS=true
#
# Per-layer overrides, so P4 and P2 can go live independently of each other.
# Unset = inherit VITE_USE_MOCKS.
#   VITE_MOCK_STORE=false   -> real Firebase auth + Firestore   (P4)
#   VITE_MOCK_TUTOR=false   -> real NVIDIA-backed tutor endpoint (P2)
# VITE_MOCK_STORE=
# VITE_MOCK_TUTOR=

# --- Tutor endpoint (owned by P2, deployed by P4) --------------------------
# Local emulator default; swap for the deployed URL once it exists.
VITE_TUTOR_ENDPOINT=http://127.0.0.1:5001/tinkersas/us-central1/tutor

# --- Firebase web config (owned by P4) -------------------------------------
# These are PUBLIC by design — they ship in the browser bundle and identify
# the project, they do not grant access. firestore.rules is the real boundary.
# Kept out of git anyway so forks don't write into our project by accident.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tinkersas.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tinkersas
VITE_FIREBASE_STORAGE_BUCKET=tinkersas.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=736464475282
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ============================================================
# SERVER-SIDE SECRETS — these belong in functions/.env, NOT here.
# Anything prefixed VITE_ is compiled into the public browser bundle.
# Never put the NVIDIA or Translate key behind a VITE_ prefix.
#   NVIDIA_API_KEY=nvapi-...
#   GOOGLE_TRANSLATE_API_KEY=...
# ============================================================
