# ============================================================
# SERVER-SIDE SECRETS. Copy to `functions/.env` — never commit it.
# These are read by the local Functions emulator.
#
# For DEPLOYED functions, use Firebase secrets instead (they are injected
# via defineSecret in index.js, not from this file):
#
#   firebase functions:secrets:set NVIDIA_API_KEY
#   firebase functions:secrets:set GOOGLE_TRANSLATE_API_KEY
# ============================================================

# From https://build.nvidia.com — free tier. Starts with "nvapi-".
NVIDIA_API_KEY=

# Google Cloud Translate API key. Only needed for the Yoruba/Shona pivot path.
GOOGLE_TRANSLATE_API_KEY=
